APP_DEBUG = true
APP_ENV = local

[DATABASE]
TYPE = mysql
HOSTNAME = 127.0.0.1
DATABASE = zs_installer
USERNAME = root
PASSWORD = 
HOSTPORT = 3306
CHARSET = utf8mb4
PREFIX = zs_

[REDIS]
HOSTNAME = 127.0.0.1
PORT = 6379
PASSWORD = 
SELECT = 0

[JWT]
KEY = zs_installer_jwt_secret_key_change_me
EXPIRE = 86400

[UPLOAD]
MAX_SIZE = 21474836480
EXTENSIONS = wim,iso,esd,swm,gho,zip,rar,7z
PATH = /data/images

[WEBSOCKET]
PORT = 2346

[BACKUP]
ENABLED = true
KEEP_DAYS = 7
PATH = /data/backup

[NOTIFICATION]
ENABLED = true
MAIL_HOST = 
MAIL_PORT = 465
MAIL_USER = 
MAIL_PASS = 
MAIL_FROM = 
