<Window x:Class="Windows_Client.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="登录 / 注册"
        Height="480" Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="Transparent"
        AllowsTransparency="True"
        FontFamily="Microsoft YaHei"
        KeyDown="OnWindowKeyDown">
    <Window.Resources>
        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#E6F0FF"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Background" Value="#1A2B4A"/>
            <Setter Property="BorderBrush" Value="#33FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#1976D2"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2196F3"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#0D5EAF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ModeButton" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#8FA3C8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#223048"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="14" Background="#16213E" BorderBrush="#335588FF" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.5" Color="#000000"/>
        </Border.Effect>
        <Grid Margin="28,24,28,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 + 关闭 -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TitleText" Text="登录 ZS 装机助手" FontSize="17" Foreground="White" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="✕" Width="30" Height="30" Background="Transparent" BorderThickness="0"
                        Foreground="#8FA3C8" FontSize="14" Cursor="Hand" Click="OnCloseClick"
                        HorizontalAlignment="Right"/>
            </Grid>

            <!-- 登录/注册 模式切换 -->
            <Border Grid.Row="1" Margin="0,18,0,0" Background="#101C36" CornerRadius="8" Padding="4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="LoginModeBtn" Content="登 录" Style="{StaticResource ModeButton}"
                            Click="OnLoginModeClick" Background="#2E5AAC"/>
                    <Button x:Name="RegisterModeBtn" Grid.Column="1" Content="注 册" Style="{StaticResource ModeButton}"
                            Click="OnRegisterModeClick"/>
                </Grid>
            </Border>

            <!-- 输入区 -->
            <StackPanel Grid.Row="2" Margin="0,18,0,0">
                <TextBlock Text="用户名" FontSize="12" Foreground="#9DB2D8" Margin="2,0,0,6"/>
                <TextBox x:Name="UsernameBox" Style="{StaticResource InputBox}" MaxLength="20"/>
                <TextBlock Text="密码" FontSize="12" Foreground="#9DB2D8" Margin="2,12,0,6"/>
                <PasswordBox x:Name="PasswordBox" Height="40" FontSize="13" Padding="12,0"
                             Foreground="#E6F0FF" Background="#1A2B4A" BorderBrush="#33FFFFFF" BorderThickness="1"
                             PasswordChar="●"/>
                <StackPanel x:Name="ConfirmPanel" Visibility="Collapsed">
                    <TextBlock Text="确认密码" FontSize="12" Foreground="#9DB2D8" Margin="2,12,0,6"/>
                    <PasswordBox x:Name="ConfirmPasswordBox" Height="40" FontSize="13" Padding="12,0"
                                 Foreground="#E6F0FF" Background="#1A2B4A" BorderBrush="#33FFFFFF" BorderThickness="1"
                                 PasswordChar="●"/>
                    <TextBlock Text="昵称（可选）" FontSize="12" Foreground="#9DB2D8" Margin="2,12,0,6"/>
                    <TextBox x:Name="NicknameBox" Style="{StaticResource InputBox}" MaxLength="20"/>
                </StackPanel>
            </StackPanel>

            <!-- 状态消息 -->
            <TextBlock x:Name="StatusText" Grid.Row="3" FontSize="12" Foreground="#FFB74D"
                       TextWrapping="Wrap" Margin="2,12,2,0" MinHeight="18"/>

            <!-- 主按钮 -->
            <Button x:Name="SubmitBtn" Grid.Row="4" Style="{StaticResource PrimaryButton}" Margin="0,10,0,0"
                    Content="登 录" Click="OnSubmitClick"/>
        </Grid>
    </Border>
</Window>
