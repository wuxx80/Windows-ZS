<Window x:Class="Windows_Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Windows_Client.ViewModels"
        Title="ZS 装机助手"
        Height="640" Width="960"
        WindowStartupLocation="CenterScreen"
        Background="#16213E"
        FontFamily="Microsoft YaHei"
        MinHeight="560" MinWidth="860"
        Loaded="OnLoaded">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>
    <Window.Resources>
        <!-- 顶部半透明胶囊按钮（设置 / 登录 / 退出） -->
        <Style x:Key="BorderGhostButton" TargetType="Button">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Background" Value="#33FFFFFF"/>
            <Setter Property="Foreground" Value="#E6F0FF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#55FFFFFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="15" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#55FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 底部文字按钮（版本 / 联系 / 关于） -->
        <Style x:Key="BottomTextButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#A8B8D8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 中央圆形入口按钮（悬停缩放 + 光晕，动效更活泼） -->
        <Style x:Key="CircleEntryButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="16" Padding="10,8">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="bdScale"/>
                            </Border.RenderTransform>
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="bdScale" Storyboard.TargetProperty="ScaleX"
                                                             To="1.06" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="bdScale" Storyboard.TargetProperty="ScaleY"
                                                             To="1.06" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="bdScale" Storyboard.TargetProperty="ScaleX"
                                                             To="1" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="bdScale" Storyboard.TargetProperty="ScaleY"
                                                             To="1" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <!-- ===== 动态炫彩背景：流动渐变 + 多色漂浮光斑 + 星尘粒子 ===== -->
        <Grid x:Name="BgLayer">
            <Border>
                <Border.Background>
                    <LinearGradientBrush x:Name="BgGrad" StartPoint="0,0" EndPoint="1,1">
                        <GradientStop x:Name="BgStop0" Color="#15233F" Offset="0"/>
                        <GradientStop x:Name="BgStopMid" Color="#1F3A75" Offset="0.5"/>
                        <GradientStop x:Name="BgStop2" Color="#2E5AAC" Offset="0.75"/>
                        <GradientStop x:Name="BgStop3" Color="#23408A" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <!-- 漂浮光斑（慢速漂移，柔和炫彩） -->
            <Ellipse Width="320" Height="320" Opacity="0.28" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-80,-80,0,0">
                <Ellipse.RenderTransform><TranslateTransform x:Name="Orb1Trans"/></Ellipse.RenderTransform>
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#7EB8FF" Offset="0"/>
                        <GradientStop Color="#007EB8FF" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse Width="420" Height="420" Opacity="0.22" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-120,-120">
                <Ellipse.RenderTransform><TranslateTransform x:Name="Orb2Trans"/></Ellipse.RenderTransform>
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#9C6BFF" Offset="0"/>
                        <GradientStop Color="#009C6BFF" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse Width="240" Height="240" Opacity="0.2" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-140,0,0">
                <Ellipse.RenderTransform><TranslateTransform x:Name="Orb3Trans"/></Ellipse.RenderTransform>
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#4FCEA8" Offset="0"/>
                        <GradientStop Color="#004FCEA8" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <!-- 琥珀色光斑（右上） -->
            <Ellipse Width="260" Height="260" Opacity="0.2" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-70,-60,0">
                <Ellipse.RenderTransform><TranslateTransform x:Name="Orb4Trans"/></Ellipse.RenderTransform>
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#FFB86C" Offset="0"/>
                        <GradientStop Color="#00FFB86C" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <!-- 粉红光斑（左下） -->
            <Ellipse Width="210" Height="210" Opacity="0.18" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-60,0,0,-60">
                <Ellipse.RenderTransform><TranslateTransform x:Name="Orb5Trans"/></Ellipse.RenderTransform>
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#FF7BB0" Offset="0"/>
                        <GradientStop Color="#00FF7BB0" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <!-- 星尘粒子层（代码动态生成闪烁粒子） -->
            <Canvas x:Name="ParticleLayer" IsHitTestVisible="False"/>
        </Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ========== 顶部栏：左上角品牌 + 右上角 连接/设置/登录 ========== -->
            <Border Grid.Row="0" BorderBrush="#33FFFFFF" BorderThickness="0,0,0,1">
                <Grid Margin="26,18,26,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="46" Height="46" CornerRadius="10" Background="#223048" BorderBrush="#55FFFFFF" BorderThickness="1">
                            <TextBlock Text="{Binding Site.LogoText}" FontSize="20" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Site.Title}" FontSize="19" Foreground="White"/>
                            <TextBlock Text="{Binding Site.Subtitle}" FontSize="11" Foreground="#A8B8D8" Margin="0,3,0,0"/>
                            <TextBlock Text="{Binding Site.Tagline}" FontSize="11" Foreground="#8FA3C8" Margin="0,3,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border CornerRadius="12" Padding="12,4" Background="#33FFFFFF" BorderBrush="#55FFFFFF" BorderThickness="1" VerticalAlignment="Center" Margin="0,0,14,0">
                            <TextBlock Text="{Binding ServerStatusText}" FontSize="11" Foreground="#DCE7FF" VerticalAlignment="Center"/>
                        </Border>
                        <Button Content="设置" Style="{StaticResource BorderGhostButton}" Command="{Binding OpenSettingsCommand}" Margin="0,0,10,0"/>
                        <Button Content="登录" Style="{StaticResource BorderGhostButton}" Command="{Binding LoginCommand}"
                                Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToInverseVisibility}}"/>
                        <Button Content="退出" Style="{StaticResource BorderGhostButton}" Command="{Binding LogoutCommand}"
                                Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVisibility}}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ========== 中央内容：最近任务横幅 + 4 圆形入口 ========== -->
            <Grid Grid.Row="1">
                <StackPanel x:Name="ContentPanel" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                    <StackPanel.RenderTransform>
                        <TranslateTransform x:Name="ContentTrans"/>
                    </StackPanel.RenderTransform>
                    <!-- 最近任务横幅（下单后显示 waiting，提示进 PE 继续；闭环可视化） -->
                    <Border Background="#223048" BorderBrush="#55FFFFFF" BorderThickness="1" CornerRadius="10" Padding="14,10"
                            Margin="70,0,70,28" Visibility="{Binding HasRecentTask, Converter={StaticResource BoolToVisibility}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="最近任务" FontSize="12" Foreground="#7EB8FF" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding RecentTaskNo}" FontSize="13" Foreground="White"/>
                                <TextBlock Text="{Binding RecentTaskStatusText}" FontSize="11" Foreground="#8FA3C8" Margin="0,2,0,0"/>
                                <TextBlock Text="任务已创建，请重启进入 WinPE 环境自动继续装机（全程无人值守）" FontSize="11" Foreground="#8FA3C8" Margin="0,4,0,0"
                                           TextWrapping="Wrap" Visibility="{Binding ShowRecentContinue, Converter={StaticResource BoolToVisibility}}"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="刷新" Height="30" Padding="16,0"
                                    Command="{Binding RefreshMyTasksCommand}" Background="#1976D2" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                        </Grid>
                    </Border>

                    <!-- 4 圆形入口：一键装机 / U盘制作 / 工具大全 / 绿色软件 -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Style="{StaticResource CircleEntryButton}" Command="{Binding OpenInstallWizardCommand}"
                                AutomationProperties.Name="一键装机">
                            <StackPanel Width="128">
                                <Grid Width="96" Height="96">
                                    <Ellipse x:Name="HaloInstall" Width="92" Height="92" Fill="#666FA8FF" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Ellipse.RenderTransform><ScaleTransform x:Name="HaloInstallScale"/></Ellipse.RenderTransform>
                                    </Ellipse>
                                    <Border Width="92" Height="92" CornerRadius="46" BorderBrush="#6FA8FF" BorderThickness="1.5" Background="#1A2B4A">
                                        <TextBlock Text="&#x1F4BD;" FontSize="34" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                                <TextBlock Text="一键装机" FontSize="15" Foreground="White" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                                <Border Background="#223048" CornerRadius="10" Padding="8,2" Margin="0,6,0,0" HorizontalAlignment="Center">
                                    <TextBlock Text="Ctrl+1" FontSize="10" Foreground="#8FA3C8"/>
                                </Border>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource CircleEntryButton}" Command="{Binding OpenUDiskCommand}"
                                AutomationProperties.Name="U盘制作">
                            <StackPanel Width="128">
                                <Grid Width="96" Height="96">
                                    <Ellipse x:Name="HaloUsb" Width="92" Height="92" Fill="#664FCEA8" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Ellipse.RenderTransform><ScaleTransform x:Name="HaloUsbScale"/></Ellipse.RenderTransform>
                                    </Ellipse>
                                    <Border Width="92" Height="92" CornerRadius="46" BorderBrush="#6FA8FF" BorderThickness="1.5" Background="#1A2B4A">
                                        <TextBlock Text="&#x1F4BF;" FontSize="34" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                                <TextBlock Text="U盘制作" FontSize="15" Foreground="White" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                                <Border Background="#223048" CornerRadius="10" Padding="8,2" Margin="0,6,0,0" HorizontalAlignment="Center">
                                    <TextBlock Text="Ctrl+2" FontSize="10" Foreground="#8FA3C8"/>
                                </Border>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource CircleEntryButton}" Command="{Binding OpenToolsCommand}"
                                AutomationProperties.Name="工具大全">
                            <StackPanel Width="128">
                                <Grid Width="96" Height="96">
                                    <Ellipse x:Name="HaloTools" Width="92" Height="92" Fill="#669C6BFF" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Ellipse.RenderTransform><ScaleTransform x:Name="HaloToolsScale"/></Ellipse.RenderTransform>
                                    </Ellipse>
                                    <Border Width="92" Height="92" CornerRadius="46" BorderBrush="#6FA8FF" BorderThickness="1.5" Background="#1A2B4A">
                                        <TextBlock Text="&#x1F527;" FontSize="34" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                                <TextBlock Text="工具大全" FontSize="15" Foreground="White" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                                <Border Background="#223048" CornerRadius="10" Padding="8,2" Margin="0,6,0,0" HorizontalAlignment="Center">
                                    <TextBlock Text="Ctrl+3" FontSize="10" Foreground="#8FA3C8"/>
                                </Border>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource CircleEntryButton}" Command="{Binding OpenSoftwareCommand}"
                                AutomationProperties.Name="绿色软件">
                            <StackPanel Width="128">
                                <Grid Width="96" Height="96">
                                    <Ellipse x:Name="HaloSoft" Width="92" Height="92" Fill="#66FFB86C" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Ellipse.RenderTransform><ScaleTransform x:Name="HaloSoftScale"/></Ellipse.RenderTransform>
                                    </Ellipse>
                                    <Border Width="92" Height="92" CornerRadius="46" BorderBrush="#6FA8FF" BorderThickness="1.5" Background="#1A2B4A">
                                        <TextBlock Text="&#x1F4E6;" FontSize="34" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                                <TextBlock Text="绿色软件" FontSize="15" Foreground="White" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                                <Border Background="#223048" CornerRadius="10" Padding="8,2" Margin="0,6,0,0" HorizontalAlignment="Center">
                                    <TextBlock Text="Ctrl+4" FontSize="10" Foreground="#8FA3C8"/>
                                </Border>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- 状态消息 -->
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="#9DB2D8" HorizontalAlignment="Center" Margin="0,24,0,0"/>
                </StackPanel>
            </Grid>

            <!-- ========== 底部栏：版权 | 版本 | 联系 关于 ========== -->
            <Border Grid.Row="2" BorderBrush="#33FFFFFF" BorderThickness="0,1,0,0">
                <Grid Margin="26,10,26,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Site.Copyright}" FontSize="11" Foreground="#8FA3C8" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <Button Grid.Column="1" Content="{Binding Site.Version}" Style="{StaticResource BottomTextButton}" Command="{Binding OpenVersionCommand}"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="18,0,0,0">
                        <Button Content="联系" Style="{StaticResource BottomTextButton}" Command="{Binding OpenContactCommand}"/>
                        <Button Content="关于" Style="{StaticResource BottomTextButton}" Command="{Binding OpenAboutCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
