<Window x:Class="Windows_Client.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="关于" Height="430" Width="460"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F5F7FA" FontFamily="Microsoft YaHei" WindowStyle="ToolWindow">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <Border Width="52" Height="52" CornerRadius="12" Background="#2A3A5C">
                <TextBlock Text="{Binding Site.LogoText}" FontSize="24" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Site.Title}" FontSize="20" Foreground="#1E293B"/>
                <TextBlock Text="{Binding Site.Subtitle}" FontSize="11" Foreground="#8896A8" Margin="0,4,0,0"/>
                <TextBlock Text="{Binding Site.Tagline}" FontSize="12" Foreground="#64748B" Margin="0,4,0,0"/>
            </StackPanel>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Border Background="White" CornerRadius="8" Padding="16">
                <StackPanel>
                    <TextBlock Text="产品介绍" FontSize="13" Foreground="#64748B" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding Site.About}" FontSize="13" Foreground="#334155" TextWrapping="Wrap" LineHeight="22"/>
                </StackPanel>
            </Border>
        </ScrollViewer>
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding Site.Version}" FontSize="12" Foreground="#8896A8"/>
                <TextBlock Text="{Binding Site.Website}" FontSize="12" Foreground="#1976D2" Margin="0,3,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" Content="联系" Width="80" Height="34" Margin="0,0,10,0"
                    Click="OnContactClick" Background="#F1F5F9" Foreground="#334155" BorderThickness="1" BorderBrush="#CBD5E1" Cursor="Hand"/>
            <Button Grid.Column="2" Content="关闭" Width="80" Height="34"
                    Click="OnCloseClick" Background="#1976D2" Foreground="White" BorderThickness="0" Cursor="Hand"/>
        </Grid>
    </Grid>
</Window>
