<Window x:Class="Windows_Client.SoftwareWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="绿色软件" Height="520" Width="620"
        WindowStartupLocation="CenterOwner"
        Background="#F5F7FA" FontFamily="Microsoft YaHei"
        Loaded="OnLoaded">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="绿色软件" FontSize="18" Foreground="#1E293B"/>
                <TextBlock Text="常用软件在线安装（需连接服务器）" FontSize="12" Foreground="#8896A8" Margin="0,4,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" Content="{Binding LoadText}" Width="90" Height="32" VerticalAlignment="Center"
                    Command="{Binding RefreshCommand}" Background="#1976D2" Foreground="White" BorderThickness="0" Cursor="Hand"/>
        </Grid>
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="4" BorderBrush="#E2E8F0" BorderThickness="1">
            <ListBox ItemsSource="{Binding SoftwareList}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="12,8" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="18" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="13" Foreground="#1E293B"/>
                                    <TextBlock Text="{Binding Version}" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding SizeDisplay}" FontSize="12" Foreground="#64748B" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="#64748B" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="关闭" Width="90" Height="34" Command="{Binding CloseCommand}"
                    Background="#1976D2" Foreground="White" BorderThickness="0" Cursor="Hand"/>
        </Grid>
    </Grid>
</Window>
