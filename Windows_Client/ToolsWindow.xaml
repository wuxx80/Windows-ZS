<Window x:Class="Windows_Client.ToolsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:Windows_Client.Helpers"
        Title="ZS 装机助手 - 工具大全"
        Width="980" Height="680"
        WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#F5F6FA"
        FontFamily="Microsoft YaHei">
    <Window.Resources>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <helpers:BoolToInverseVisibilityConverter x:Key="InvBoolToVis"/>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="30"/>
            <Setter Property="MinWidth" Value="72"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Background" Value="#1890FF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#40A9FF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#D9D9D9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="92"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderBrush" Value="#D9D9D9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F5F5F5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CategoryItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" CornerRadius="14" Padding="14,5" BorderThickness="1" BorderBrush="#E8E8E8" Background="#FAFAFA">
                            <TextBlock x:Name="txt" Text="{Binding Name}" FontSize="13" Foreground="#555" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F0F5FF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E6F7FF"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#1890FF"/>
                                <Setter TargetName="txt" Property="Foreground" Value="#1890FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="58"/>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="#E8E8E8" BorderThickness="0,0,0,1" MouseLeftButtonDown="OnTitleBarMouseDown">
            <Grid>
                <TextBlock Text="ZS 装机助手 - 工具大全" FontSize="14" Foreground="#333" VerticalAlignment="Center" Margin="16,0,0,0"/>
                <Button Content="&#x2715;" Width="40" Height="40" HorizontalAlignment="Right" Background="Transparent" Foreground="#666" FontSize="14" Cursor="Hand" BorderThickness="0" ToolTip="关闭" Click="OnCloseClick">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#E8E8E8"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="White" BorderBrush="#E8E8E8" BorderThickness="0,0,0,1" Padding="16,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="230"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="工具大全" FontSize="18" Foreground="#333"/>
                    <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="#8C8C8C" Margin="0,2,0,0"/>
                </StackPanel>
                <Button Grid.Column="2" Content="{Binding SyncText}" Style="{StaticResource SecondaryButton}" Margin="0,0,12,0"
                        VerticalAlignment="Center" Command="{Binding SyncCommand}" IsEnabled="{Binding IsNotSyncing}"/>
                <Grid Grid.Column="3" VerticalAlignment="Center">
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Height="34" FontSize="13" Padding="10,0" VerticalContentAlignment="Center"/>
                    <TextBlock Text="搜索工具名称..." FontSize="12" Foreground="#BFBFBF" VerticalAlignment="Center" Margin="12,0,0,0"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SearchText}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="White" BorderBrush="#E8E8E8" BorderThickness="0,0,0,1" Padding="16,7">
            <ListBox ItemsSource="{Binding Categories}" SelectedItem="{Binding CurrentCategory}"
                     ItemContainerStyle="{StaticResource CategoryItem}" Background="Transparent" BorderThickness="0">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel VerticalAlignment="Center"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>
        </Border>

        <Grid Grid.Row="3" Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding FilteredTools}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="300" Margin="0,0,12,12" Background="White" CornerRadius="8"
                                    BorderBrush="#E8E8E8" BorderThickness="1" Padding="14">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="46"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="42" Height="42" CornerRadius="8" Background="#F0F5FF">
                                            <TextBlock Text="{Binding Icon}" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontSize="14" Foreground="#333" TextTrimming="CharacterEllipsis" MaxWidth="150"/>
                                                <Border Background="#F0F5FF" CornerRadius="8" Padding="6,1" Margin="6,1,0,0">
                                                    <TextBlock Text="{Binding SourceBadge}" FontSize="10" Foreground="{Binding SourceBadgeColor}"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding SizeDisplay}" FontSize="11" Foreground="#8C8C8C" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Grid.Row="1" Text="{Binding Description}" FontSize="12" Foreground="#8C8C8C"
                                               TextWrapping="Wrap" Margin="0,8,0,0"/>
                                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                        <Button Content="运行" Style="{StaticResource PrimaryButton}"
                                                Command="{Binding DataContext.RunCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" Visibility="{Binding ShowRun, Converter={StaticResource BoolToVis}}"/>
                                        <Button Content="下载" Style="{StaticResource PrimaryButton}"
                                                Command="{Binding DataContext.DownloadCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" Visibility="{Binding ShowDownload, Converter={StaticResource BoolToVis}}"/>
                                        <TextBlock Text="下载中..." FontSize="12" Foreground="#1890FF" VerticalAlignment="Center"
                                                   Visibility="{Binding ShowDownloading, Converter={StaticResource BoolToVis}}"/>
                                        <Button Content="打开目录" Style="{StaticResource SecondaryButton}" MinWidth="76" Height="30" Padding="10,0"
                                                Command="{Binding DataContext.OpenDirectoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" Visibility="{Binding ShowOpenFolder, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="{Binding HasNoTools, Converter={StaticResource BoolToVis}}" IsHitTestVisible="False">
                <TextBlock Text="&#x1F50D;" FontSize="40" HorizontalAlignment="Center"/>
                <TextBlock Text="未找到工具" FontSize="15" Foreground="#666" HorizontalAlignment="Center" Margin="0,10,0,4"/>
                <TextBlock Text="换个分类或关键词试试" FontSize="12" Foreground="#999" HorizontalAlignment="Center"/>
            </StackPanel>

            <Border Grid.Row="1" Background="#F0F5FF" CornerRadius="6" Padding="12,8" Margin="0,4,0,0">
                <TextBlock Text="提示：点击「运行」立即执行；服务器工具首次运行自动下载；缺文件工具可「打开目录」手动放入绿色工具" FontSize="12" Foreground="#597EF7" TextWrapping="Wrap"/>
            </Border>
        </Grid>
    </Grid>
</Window>