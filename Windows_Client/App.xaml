<Application x:Class="Windows_Client.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:Windows_Client.Helpers"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <helpers:ViewConverter x:Key="ViewConverter"/>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <helpers:BoolToInverseVisibilityConverter x:Key="BoolToInverseVisibility"/>
    </Application.Resources>
</Application>