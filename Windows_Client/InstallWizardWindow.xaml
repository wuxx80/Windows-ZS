<Window x:Class="Windows_Client.InstallWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:Windows_Client.Helpers"
        Title="ZS 装机助手 - 一键装机"
        Width="860" Height="600"
        WindowStartupLocation="CenterScreen"
        Background="#F5F6FA"
        FontFamily="Microsoft YaHei">
    <Window.Resources>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <helpers:BoolToInverseVisibilityConverter x:Key="InvBoolToVis"/>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="Background" Value="#1890FF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="20,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#40A9FF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#D9D9D9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderBrush" Value="#D9D9D9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="16,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F5F5F5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardListBoxItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" Background="White" BorderBrush="#E8E8E8" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,6">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F0F5FF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E6F7FF"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#1890FF"/>
                                <Setter TargetName="bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="54"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E8E8E8" BorderThickness="0,0,0,1" MouseLeftButtonDown="OnTitleBarMouseDown">
            <Grid>
                <TextBlock Text="ZS 装机助手 - 一键装机" FontSize="14" Foreground="#333" VerticalAlignment="Center" Margin="16,0,0,0"/>
                <Button Content="✕" Width="40" Height="40" HorizontalAlignment="Right" Background="Transparent" Foreground="#666" FontSize="14" Cursor="Hand" BorderThickness="0" Click="OnCloseClick">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#E8E8E8"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <!-- 内容区域 -->
        <Grid Grid.Row="1" Margin="24">
            <!-- ===== 步骤 1: 选择镜像 ===== -->
            <Grid Visibility="{Binding IsStepImage, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="选择镜像" FontSize="18" Foreground="#333"/>
                    <TextBlock Text="从服务器选择要安装的系统镜像" FontSize="13" Foreground="#8C8C8C" Margin="0,4,0,0"/>
                </StackPanel>
                <Grid Grid.Row="1" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}" Height="30" FontSize="13" Padding="6,0" VerticalContentAlignment="Center" Margin="0,0,10,0" ToolTip="搜索镜像名称"/>
                    <Button Grid.Column="1" Content="刷新" Style="{StaticResource SecondaryButton}" Height="30" Command="{Binding RefreshImagesCommand}"/>
                </Grid>
                <ListBox Grid.Row="2" ItemsSource="{Binding Images}" SelectedItem="{Binding SelectedImage}" ItemContainerStyle="{StaticResource CardListBoxItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="◯" FontSize="16" Foreground="#D9D9D9" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="{Binding Name}" FontSize="15" Foreground="#1A1A1A"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock Text="{Binding Format}" FontSize="12" Foreground="#1890FF" Margin="0,0,10,0"/>
                                        <TextBlock Text="{Binding SizeDisplay}" FontSize="12" Foreground="#8C8C8C" Margin="0,0,10,0"/>
                                        <TextBlock Text="{Binding OsType}" FontSize="12" Foreground="#8C8C8C"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                    <Button Content="下一步" Style="{StaticResource PrimaryButton}" Command="{Binding NextStepCommand}"/>
                </StackPanel>
            </Grid>

            <!-- ===== 步骤 2: 目标磁盘 + 选项 ===== -->
            <Grid Visibility="{Binding IsStepDisk, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="目标磁盘与选项" FontSize="18" Foreground="#333"/>
                    <TextBlock Text="选择安装目标磁盘，配置可选功能" FontSize="13" Foreground="#8C8C8C" Margin="0,4,0,0"/>
                </StackPanel>
                <Border Grid.Row="1" Background="#E6F7FF" CornerRadius="6" Padding="10,6" Margin="0,0,0,10">
                    <TextBlock FontSize="12" Foreground="#1890FF">
                        <Run Text="已选镜像:"/>
                        <Run Text="{Binding SelectedImage.Name, TargetNullValue=未选择}" FontWeight="Bold"/>
                    </TextBlock>
                </Border>

                <Grid Grid.Row="2" Margin="0,0,0,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="选择目标磁盘" FontSize="14" Foreground="#333" VerticalAlignment="Center"/>
                    </Grid>
                    <ListBox Grid.Row="1" ItemsSource="{Binding Disks}" SelectedItem="{Binding SelectedDisk}" ItemContainerStyle="{StaticResource CardListBoxItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="◯" FontSize="16" Foreground="#D9D9D9" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                                        <TextBlock Text="{Binding Model, StringFormat=磁盘 {0}}" FontSize="15" Foreground="#1A1A1A" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding SizeDisplay}" FontSize="12" Foreground="#8C8C8C" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <!-- 选项 -->
                <Border Grid.Row="3" Background="White" BorderBrush="#E8E8E8" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="安装选项" FontSize="14" Foreground="#333" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#FAFAFA" BorderBrush="#E8E8E8" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,6,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="注入驱动" FontSize="13" Foreground="#333" VerticalAlignment="Center"/>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding OptionInjectDriver}" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <Border Grid.Column="1" Background="#FAFAFA" BorderBrush="#E8E8E8" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="3,0,3,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="安装软件" FontSize="13" Foreground="#333" VerticalAlignment="Center"/>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding OptionInstallSoftware}" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <Border Grid.Column="2" Background="#FAFAFA" BorderBrush="#E8E8E8" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="6,0,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="自动分区" FontSize="13" Foreground="#333" VerticalAlignment="Center"/>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding OptionAutoPartition}" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="上一步" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Command="{Binding PrevStepCommand}"/>
                    <Button Grid.Column="1" Content="开始装机" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Background="#52C41A" Command="{Binding StartInstallCommand}"/>
                </Grid>
            </Grid>

            <!-- ===== 步骤 3: 执行进度 ===== -->
            <Grid Visibility="{Binding IsStepProgress, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="执行装机" FontSize="18" Foreground="#333"/>
                    <TextBlock Text="{Binding StatusText}" FontSize="13" Foreground="#8C8C8C" Margin="0,4,0,0"/>
                </StackPanel>
                <Border Grid.Row="1" Background="White" BorderBrush="#E8E8E8" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,10">
                    <StackPanel>
                        <ProgressBar Value="{Binding ProgressValue}" Height="8" Margin="0,0,0,6" Foreground="#1890FF" Background="#F0F0F0"/>
                        <TextBlock Text="{Binding ProgressText}" FontSize="12" Foreground="#8C8C8C" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Grid.Row="2" Background="#1A1A1A" CornerRadius="6" Padding="12,8">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Logs}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock FontFamily="Consolas" FontSize="12" Foreground="#00E676">
                                        <Run Text="{Binding Time}"/>
                                        <Run Text="  "/>
                                        <Run Text="{Binding Text}"/>
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>

        <!-- 底部按钮 -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E8E8E8" BorderThickness="0,1,0,0" Padding="24,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" FontSize="12" Foreground="#8C8C8C" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="关闭" Style="{StaticResource SecondaryButton}" Click="OnCloseClick"
                        Visibility="{Binding ShowCloseButton, Converter={StaticResource BoolToVis}}"/>
            </Grid>
        </Border>
    </Grid>
</Window>