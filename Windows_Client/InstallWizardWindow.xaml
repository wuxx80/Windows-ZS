<Window x:Class="Windows_Client.InstallWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:Windows_Client.Helpers"
        Title="ZS 装机助手 - 一键装机"
        Width="900" Height="640"
        WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#F5F6FA"
        FontFamily="Microsoft YaHei">
    <Window.Resources>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <helpers:BoolToInverseVisibilityConverter x:Key="InvBoolToVis"/>
        <helpers:StringToBrushConverter x:Key="StrToBrush"/>
        <helpers:IndexZeroToBoolConverter x:Key="IndexZeroToBoolConverter"/>
        <helpers:IndexOneToBoolConverter x:Key="IndexOneToBoolConverter"/>
        <helpers:IndexTwoToBoolConverter x:Key="IndexTwoToBoolConverter"/>

        <!-- ===== 按钮样式 ===== -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="Background" Value="#1890FF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#40A9FF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#D9D9D9"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderBrush" Value="#D9D9D9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F5F5F5"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#F5F5F5"/>
                                <Setter Property="Foreground" Value="#D9D9D9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Background" Value="#FF4D4F"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF7875"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#F5F5F5"/>
                                <Setter Property="Foreground" Value="#D9D9D9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#1890FF"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F0F5FF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#D9D9D9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 卡片选中样式（镜像/磁盘） ===== -->
        <Style x:Key="CardListBoxItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" Background="White" BorderBrush="#E8E8E8" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,6">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F0F5FF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E6F7FF"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#1890FF"/>
                                <Setter TargetName="bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 来源 Tab 样式 ===== -->
        <Style x:Key="SourceTabItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" CornerRadius="6" Padding="14,6" Background="#F0F0F0" BorderThickness="1" BorderBrush="#E8E8E8">
                            <StackPanel>
                                <ContentPresenter HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding Desc}" FontSize="10" Foreground="#8C8C8C" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E6F7FF"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#1890FF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F5F5F5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 选项药丸卡片样式 ===== -->
        <Style x:Key="OptionPill" TargetType="Border">
            <Setter Property="Width" Value="156"/>
            <Setter Property="Height" Value="58"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#E8E8E8"/>
            <Setter Property="Background" Value="#FAFAFA"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="54"/>
        </Grid.RowDefinitions>

        <!-- ===== 标题栏 ===== -->
        <Border x:Name="TitleBar" Grid.Row="0" Background="White" BorderBrush="#E8E8E8" BorderThickness="0,0,0,1" MouseLeftButtonDown="OnTitleBarMouseDown">
            <Grid>
                <TextBlock Text="ZS 装机助手 - 一键装机" FontSize="14" Foreground="#333" VerticalAlignment="Center" Margin="16,0,0,0"/>
                <Button Content="✕" Width="40" Height="40" HorizontalAlignment="Right" Background="Transparent" Foreground="#666" FontSize="14" Cursor="Hand" BorderThickness="0"
                        ToolTip="关闭" Click="OnCloseClick">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#E8E8E8"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <!-- ===== 步骤导航栏 ===== -->
        <Border Grid.Row="1" Background="White" BorderBrush="#E8E8E8" BorderThickness="0,0,0,1">
            <ItemsControl ItemsSource="{Binding Steps}" VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="connector" Width="22" Height="2" Background="#E8E8E8" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <Border x:Name="dot" Width="24" Height="24" CornerRadius="12" BorderThickness="2" BorderBrush="#D9D9D9" VerticalAlignment="Center" Margin="0,0,6,0">
                                <TextBlock x:Name="txt" Text="{Binding Icon}" FontSize="11" Foreground="#BFBFBF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock x:Name="lbl" Text="{Binding Name}" FontSize="13" Foreground="#BFBFBF" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        </StackPanel>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                <Setter TargetName="dot" Property="BorderBrush" Value="#1890FF"/>
                                <Setter TargetName="txt" Property="Foreground" Value="#1890FF"/>
                                <Setter TargetName="txt" Property="FontSize" Value="14"/>
                                <Setter TargetName="lbl" Property="Foreground" Value="#1890FF"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                <Setter TargetName="connector" Property="Background" Value="#52C41A"/>
                                <Setter TargetName="dot" Property="BorderBrush" Value="#52C41A"/>
                                <Setter TargetName="txt" Property="Foreground" Value="#52C41A"/>
                                <Setter TargetName="lbl" Property="Foreground" Value="#52C41A"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsError}" Value="True">
                                <Setter TargetName="dot" Property="BorderBrush" Value="#FF4D4F"/>
                                <Setter TargetName="txt" Property="Foreground" Value="#FF4D4F"/>
                                <Setter TargetName="lbl" Property="Foreground" Value="#FF4D4F"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Index}" Value="0">
                                <Setter TargetName="connector" Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>        <!-- ===== 内容区域 ===== -->
        <Grid Grid.Row="2">
            <!-- ========== 步骤① 环境检测 ========== -->
            <Grid Visibility="{Binding IsStep0, Converter={StaticResource BoolToVis}}" Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="0,0,0,12">
                    <TextBlock Text="环境检测" FontSize="18" Foreground="#333"/>
                    <TextBlock Text="{Binding StatusText}" FontSize="13" Foreground="#8C8C8C" Margin="0,4,0,0"/>
                </StackPanel>
                <Border Grid.Row="1" Background="White" BorderBrush="#E8E8E8" BorderThickness="1" CornerRadius="8" Padding="16,12">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding Checks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="6,3" CornerRadius="4" Background="{Binding RowBg}">
                                        <Grid Height="34">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding StatusIcon}" FontSize="15" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding IndexText}" FontSize="11" Foreground="#BFBFBF" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="14" Foreground="#333" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <Border Background="#FFF7E6" CornerRadius="3" Padding="5,0" Margin="0,0,4,0" Visibility="{Binding ShowSeverityWarning, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="警告" FontSize="10" Foreground="#D46B08"/>
                                                </Border>
                                                <Border Background="#FFF1F0" CornerRadius="3" Padding="5,0" Visibility="{Binding ShowSeverityFatal, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="致命" FontSize="10" Foreground="#CF1322"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Grid.Column="3" Text="{Binding Detail}" FontSize="12" Foreground="#999" VerticalAlignment="Center" Margin="0,0,10,0" TextTrimming="CharacterEllipsis" MaxWidth="260"/>
                                            <TextBlock Grid.Column="4" Text="{Binding StatusText}" FontSize="12" Foreground="#8C8C8C" VerticalAlignment="Center" Margin="0,0,8,0" Width="56"/>
                                            <Button Grid.Column="5" Content="修复" Style="{StaticResource LinkButton}" Visibility="{Binding ShowRepair, Converter={StaticResource BoolToVis}}"
                                                    Command="{Binding DataContext.RepairCheckCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding Index}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ProgressBar Value="{Binding ProgressValue}" Height="6" Margin="0,10,0,0" Foreground="#1890FF" Background="#F0F0F0"/>
                    </StackPanel>
                </Border>
                <!-- 异常汇总（设计文档 §3.5） -->
                <Border Grid.Row="2" Visibility="{Binding ShowIssueSummary, Converter={StaticResource BoolToVis}}" Background="#FFFBE6" BorderBrush="#FFE58F" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,14,0,0" MaxHeight="180">
                    <StackPanel>
                        <TextBlock Text="环境检测发现以下问题" FontSize="14" Foreground="#AD6800" Margin="0,0,0,8"/>
                        <ItemsControl ItemsSource="{Binding EnvIssues}" MaxHeight="96">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding Bg}" BorderBrush="{Binding Border}" BorderThickness="1" CornerRadius="4" Padding="10,5" Margin="0,0,0,4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="24"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="13" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" Foreground="#333" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Detail}" FontSize="12" Foreground="#8C8C8C" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Background="{Binding Border}" CornerRadius="3" Padding="6,1" Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding SeverityText}" FontSize="10" Foreground="#AD6800"/>
                                                </Border>
                                                <Button Content="修复" Style="{StaticResource LinkButton}" Height="24"
                                                        Command="{Binding DataContext.RepairCheckCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding Index}"/>
                                                <Button Content="忽略" Style="{StaticResource LinkButton}" Height="24" Visibility="{Binding ShowIgnore, Converter={StaticResource BoolToVis}}"
                                                        Command="{Binding DataContext.IgnoreIssueCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                            <Button Content="全部修复" Command="{Binding RepairAllCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0"/>
                            <Button Content="强制继续" Command="{Binding ForceContinueCommand}" Style="{StaticResource PrimaryButton}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <StackPanel Grid.Row="3" VerticalAlignment="Bottom" HorizontalAlignment="Right">
                    <Button Content="退出" Command="{Binding BackHomeCommand}" Style="{StaticResource LinkButton}"/>
                </StackPanel>
            </Grid>

            <!-- ========== 步骤② 选择镜像 ========== -->
            <Grid Visibility="{Binding IsStep1, Converter={StaticResource BoolToVis}}" Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="选择镜像" FontSize="18" Foreground="#333"/>
                    <TextBlock Text="{Binding StatusText}" FontSize="13" Foreground="#8C8C8C" Margin="0,4,0,0"/>
                </StackPanel>
                <!-- 来源切换（设计文档 §4.4） -->
                <ListBox Grid.Row="1" ItemsSource="{Binding ImageSourceItems}" SelectedItem="{Binding SelectedImageSource}"
                         ItemContainerStyle="{StaticResource SourceTabItem}" HorizontalAlignment="Left" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,10">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" FontSize="13" Foreground="#333"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <!-- 远程 URL 面板（设计文档 §4.6） -->
                <Border Grid.Row="2" Visibility="{Binding ShowAddUrlPanel, Converter={StaticResource BoolToVis}}" Background="White" BorderBrush="#E8E8E8" BorderThickness="1" CornerRadius="8" Padding="16" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="添加远程镜像 URL" FontSize="14" Foreground="#333" Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding RemoteUrl, UpdateSourceTrigger=PropertyChanged}" Height="32" FontSize="13" Padding="6,0" VerticalContentAlignment="Center" BorderBrush="#D9D9D9" ToolTip="http(s):// 镜像下载地址"/>
                            <TextBox Grid.Column="1" Text="{Binding RemoteName, UpdateSourceTrigger=PropertyChanged}" Height="32" FontSize="13" Padding="6,0" VerticalContentAlignment="Center" BorderBrush="#D9D9D9" Margin="10,0,0,0" ToolTip="镜像名称（可选）"/>
                            <Button Grid.Column="2" Content="添加" Style="{StaticResource PrimaryButton}" Height="32" Margin="10,0,0,0" Command="{Binding AddRemoteUrlCommand}"/>
                        </Grid>
                        <TextBlock Text="{Binding RemoteUrlStatus}" FontSize="12" Foreground="#8C8C8C" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
                <!-- 镜像列表（设计文档 §4.1-4.3） -->
                <Grid Grid.Row="2" Visibility="{Binding ShowImageList, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}" Height="30" FontSize="13" Padding="6,0" VerticalContentAlignment="Center" BorderBrush="#D9D9D9" Margin="0,0,10,0" ToolTip="搜索镜像名称"/>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding FormatFilters}" SelectedItem="{Binding SelectedFormatFilter}" Height="30" Width="100" FontSize="13" Margin="0,0,10,0"/>
                        <ComboBox Grid.Column="2" ItemsSource="{Binding OsTypeFilters}" SelectedItem="{Binding SelectedOsTypeFilter}" Height="30" Width="110" FontSize="13" Margin="0,0,10,0"/>
                        <Button Grid.Column="3" Content="刷新" Style="{StaticResource SecondaryButton}" Height="30" Command="{Binding RefreshImagesCommand}"/>
                    </Grid>
                    <ListBox Grid.Row="1" ItemsSource="{Binding Images}" SelectedItem="{Binding SelectedImage}" ItemContainerStyle="{StaticResource CardListBoxItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="◯" FontSize="16" Foreground="#D9D9D9" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontSize="15" Foreground="#1A1A1A" VerticalAlignment="Center"/>
                                            <Border Background="#E6F7FF" CornerRadius="3" Padding="5,1" Margin="8,0,0,0" Visibility="{Binding IsRecommended, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="推荐" FontSize="10" Foreground="#1890FF"/>
                                            </Border>
                                            <Border Background="#FFF7E6" CornerRadius="3" Padding="5,1" Margin="4,0,0,0" Visibility="{Binding IsNew, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="新" FontSize="10" Foreground="#D46B08"/>
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <Border Background="#E6F7FF" CornerRadius="3" Padding="6,1" Margin="0,0,6,0">
                                                <TextBlock Text="{Binding Format}" FontSize="11" Foreground="#1890FF"/>
                                            </Border>
                                            <TextBlock Text="{Binding SizeDisplay}" FontSize="12" Foreground="#8C8C8C" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding OsType}" FontSize="12" Foreground="#8C8C8C" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding OsVersion}" FontSize="12" Foreground="#8C8C8C" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding DateText}" FontSize="12" Foreground="#8C8C8C" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding InstallCount, StringFormat=装机 {0} 次}" FontSize="12" Foreground="#8C8C8C" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Description}" FontSize="12" Foreground="#595959" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" MaxWidth="540"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding CacheText}" FontSize="12" Foreground="#1890FF" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button Content="上一页" Style="{StaticResource SecondaryButton}" Height="28" Command="{Binding PrevImagePageCommand}" Margin="0,0,10,0"/>
                        <TextBlock Text="{Binding PageText}" FontSize="12" Foreground="#8C8C8C" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Button Content="下一页" Style="{StaticResource SecondaryButton}" Height="28" Command="{Binding NextImagePageCommand}"/>
                    </StackPanel>
                </Grid>
            </Grid>            <!-- ========== 步骤③ 目标磁盘 ========== -->
            <Grid Visibility="{Binding IsStep2, Converter={StaticResource BoolToVis}}" Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="目标磁盘" FontSize="18" Foreground="#333"/>
                    <TextBlock Text="{Binding StatusText}" FontSize="13" Foreground="#8C8C8C" Margin="0,4,0,0"/>
                </StackPanel>
                <Border Grid.Row="1" Background="#E6F7FF" CornerRadius="6" Padding="10,6" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="已选镜像:" FontSize="12" Foreground="#1890FF"/>
                        <TextBlock Text="{Binding SelectedImage.Name, TargetNullValue=未选择}" FontSize="12" Foreground="#1890FF" Margin="6,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="560"/>
                    </StackPanel>
                </Border>
                <Grid Grid.Row="2" Margin="0,0,0,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="选择目标磁盘" FontSize="14" Foreground="#333" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="刷新" Style="{StaticResource SecondaryButton}" Height="30" Command="{Binding RefreshDisksCommand}"/>
                    </Grid>
                    <ListBox Grid.Row="1" ItemsSource="{Binding Disks}" SelectedItem="{Binding SelectedDisk}" ItemContainerStyle="{StaticResource CardListBoxItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="◯" FontSize="16" Foreground="#D9D9D9" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding Model, StringFormat=磁盘 {0}}" FontSize="15" Foreground="#1A1A1A" VerticalAlignment="Center"/>
                                            <Border Background="#F0F5FF" CornerRadius="3" Padding="6,1" Margin="8,0,0,0">
                                                <TextBlock Text="{Binding PartitionTable}" FontSize="11" Foreground="#1890FF"/>
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding SizeDisplay}" FontSize="12" Foreground="#8C8C8C" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding InterfaceType}" FontSize="12" Foreground="#8C8C8C" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                            <Border Background="#F0F0F0" CornerRadius="3" Padding="6,1">
                                                <TextBlock Text="{Binding IsSsd, StringFormat={}{0}}" FontSize="11" Foreground="#666"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding Partitions}" Margin="32,4,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,2,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="44"/>
                                                        <ColumnDefinition Width="70"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding DriveLetter}" FontSize="12" Foreground="#1890FF"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding FileSystem}" FontSize="12" Foreground="#666"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Label}" FontSize="12" Foreground="#8C8C8C" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding SizeDisplay}" FontSize="12" Foreground="#8C8C8C"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <!-- 冲突检测（设计文档 §5.4） -->
                    <ItemsControl Grid.Row="2" ItemsSource="{Binding DiskConflicts}" Visibility="{Binding ShowDiskConflicts, Converter={StaticResource BoolToVis}}" Margin="0,6,0,0" MaxHeight="74">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{Binding Bg}" BorderBrush="{Binding Border}" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,0,4">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Icon}" FontSize="12" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Text}" FontSize="12" Foreground="#595959" Margin="6,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
                <!-- 分区方案（设计文档 §5.5） -->
                <StackPanel Grid.Row="3">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="分区方案:" FontSize="13" Foreground="#595959" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <RadioButton GroupName="part" Content="自动分区 (GPT)" IsChecked="{Binding PartitionScheme, Converter={StaticResource IndexZeroToBoolConverter}}" FontSize="13" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <RadioButton GroupName="part" Content="保留现有分区" IsChecked="{Binding PartitionScheme, Converter={StaticResource IndexOneToBoolConverter}}" FontSize="13" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <RadioButton GroupName="part" Content="自定义分区" IsChecked="{Binding PartitionScheme, Converter={StaticResource IndexTwoToBoolConverter}}" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                    <!-- 自定义分区编辑器（设计文档 §5.5） -->
                    <Border Visibility="{Binding ShowCustomPartitionPanel, Converter={StaticResource BoolToVis}}" Background="White" BorderBrush="#E8E8E8" BorderThickness="1" CornerRadius="8" Padding="14,10">
                        <StackPanel>
                            <TextBlock Text="分区编辑器" FontSize="14" Foreground="#333" Margin="0,0,0,6"/>
                            <ItemsControl ItemsSource="{Binding PartitionEditItems}" MaxHeight="120">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2,0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="50"/>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding DriveLetter}" FontSize="13" Foreground="#1890FF" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding SizeText}" FontSize="13" Foreground="#333" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding FileSystem}" FontSize="13" Foreground="#333" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="3" Text="{Binding Label}" FontSize="12" Foreground="#8C8C8C" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                                <Button Content="恢复默认" Style="{StaticResource SecondaryButton}" Height="30" Command="{Binding ApplyPartitionCommand}" Margin="0,0,10,0"/>
                                <Button Content="应用分区方案" Style="{StaticResource PrimaryButton}" Height="30" Command="{Binding ApplyPartitionCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- ========== 步骤④ 安装选项 ========== -->
            <Grid Visibility="{Binding IsStep3, Converter={StaticResource BoolToVis}}" Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="安装选项" FontSize="18" Foreground="#333"/>
                    <TextBlock Text="点击选项卡片开启或关闭对应功能" FontSize="13" Foreground="#8C8C8C" Margin="0,4,0,0"/>
                </StackPanel>
                <ItemsControl Grid.Row="1" ItemsSource="{Binding Options}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="card" Style="{StaticResource OptionPill}" Cursor="Hand">
                                <Button Background="Transparent" BorderThickness="0" Command="{Binding DataContext.ToggleOptionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="Transparent">
                                                <ContentPresenter/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="13" Foreground="#333"/>
                                            <TextBlock Text="{Binding Sub}" FontSize="10" Foreground="#999" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding ToggleText}" FontSize="14" Foreground="#1890FF" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    </Grid>
                                </Button>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsOn}" Value="True">
                                    <Setter TargetName="card" Property="Background" Value="#E6F7FF"/>
                                    <Setter TargetName="card" Property="BorderBrush" Value="#91D5FF"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <!-- 扩展配置面板（设计文档 §6.2 按选项开关显示） -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
                    <Border Background="White" BorderBrush="#E8E8E8" BorderThickness="1" CornerRadius="8" Padding="16,12">
                        <StackPanel>
                            <TextBlock Text="扩展配置" FontSize="14" Foreground="#333" Margin="0,0,0,10"/>
                            <Grid Visibility="{Binding ShowUnattendPanel, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="无人值守模板" FontSize="13" Foreground="#595959" VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding UnattendTemplates}" SelectedItem="{Binding SelectedUnattendTemplate}" Height="30" FontSize="13"/>
                            </Grid>
                            <Grid Visibility="{Binding ShowSoftwarePanel, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="软件包模板" FontSize="13" Foreground="#595959" VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding SoftwareTemplates}" SelectedItem="{Binding SelectedSoftwareTemplate}" Height="30" FontSize="13"/>
                            </Grid>
                            <Grid Visibility="{Binding ShowDriverPanel, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="驱动包" FontSize="13" Foreground="#595959" VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding DriverPackages}" SelectedItem="{Binding SelectedDriverPackage}" Height="30" FontSize="13"/>
                            </Grid>
                            <Grid Visibility="{Binding ShowOptimizePanel, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="优化方案" FontSize="13" Foreground="#595959" VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding OptimizePlans}" SelectedItem="{Binding SelectedOptimizePlan}" Height="30" FontSize="13"/>
                            </Grid>
                            <Grid Visibility="{Binding ShowBackupPanel, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="备份位置" FontSize="13" Foreground="#595959" VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding BackupLocations}" SelectedItem="{Binding SelectedBackupLocation}" Height="30" FontSize="13"/>
                            </Grid>
                            <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="#8C8C8C" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </Grid>            <!-- ========== 步骤⑤ 确认 ========== -->
            <Grid Visibility="{Binding IsStep4, Converter={StaticResource BoolToVis}}" Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="确认装机信息" FontSize="18" Foreground="#333"/>
                    <TextBlock Text="请确认以下信息，确认后将开始装机" FontSize="13" Foreground="#8C8C8C" Margin="0,4,0,0"/>
                </StackPanel>
                <!-- 冲突横幅（设计文档 §7.2） -->
                <Border Grid.Row="1" Background="{Binding ConfirmBannerBg, Converter={StaticResource StrToBrush}}" BorderBrush="{Binding ConfirmBannerBorder, Converter={StaticResource StrToBrush}}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding ConfirmBannerIcon}" FontSize="16" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ConfirmBannerText}" FontSize="13" Foreground="#333" Margin="8,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <!-- 确认冲突明细 -->
                <ItemsControl Grid.Row="2" ItemsSource="{Binding ConfirmConflicts}" Margin="0,0,0,8" MaxHeight="84">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{Binding Bg}" BorderBrush="{Binding Border}" BorderThickness="1" CornerRadius="4" Padding="10,4" Margin="0,0,0,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Icon}" FontSize="12" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Text}" FontSize="12" Foreground="#595959" Margin="6,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="640"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border Grid.Row="3" Background="White" BorderBrush="#E8E8E8" BorderThickness="1" CornerRadius="8" Padding="8">
                    <ItemsControl ItemsSource="{Binding SummaryItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="12,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="16" VerticalAlignment="Top"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="14" Foreground="#1A1A1A" VerticalAlignment="Top"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Content}" FontSize="13" Foreground="#595959" TextWrapping="Wrap" VerticalAlignment="Top"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </Grid>

            <!-- ========== 步骤⑥ 执行 + 完成 ========== -->
            <Grid Visibility="{Binding IsStep5, Converter={StaticResource BoolToVis}}">
                <!-- 执行中（设计文档 §8） -->
                <Grid Visibility="{Binding ShowExecution, Converter={StaticResource BoolToVis}}" Margin="24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="执行装机" FontSize="18" Foreground="#333"/>
                            <TextBlock Text="{Binding StatusText}" FontSize="13" Foreground="#8C8C8C" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Visibility="{Binding ShowExecControls, Converter={StaticResource BoolToVis}}">
                            <Button Content="{Binding PauseText}" Style="{StaticResource SecondaryButton}" Height="30" Command="{Binding PauseCommand}" Margin="0,0,8,0"/>
                            <Button Content="取消" Style="{StaticResource DangerButton}" Height="30" Command="{Binding CancelCommand}"/>
                        </StackPanel>
                    </Grid>
                    <!-- 主进度条（分段彩色，设计文档 §8.2） -->
                    <Border Grid.Row="1" Background="White" BorderBrush="#E8E8E8" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,10">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="{Binding ProgressText}" FontSize="13" Foreground="#333" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding ElapsedText}" FontSize="12" Foreground="#8C8C8C" HorizontalAlignment="Right"/>
                            </Grid>
                            <ProgressBar Value="{Binding ProgressValue}" Height="10" Margin="0,6,0,0"
                                         Foreground="{Binding ProgressColor, Converter={StaticResource StrToBrush}}" Background="#F0F0F0"/>
                        </StackPanel>
                    </Border>
                    <!-- 执行步骤清单（逐项实时联动） -->
                    <Border Grid.Row="2" Background="White" BorderBrush="#E8E8E8" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                        <ItemsControl ItemsSource="{Binding ExecSteps}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="26">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="26"/>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="110"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding StatusIcon}" FontSize="14" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" Foreground="#333" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Detail}" FontSize="12" Foreground="#8C8C8C" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <ProgressBar Grid.Column="3" Value="{Binding Progress}" Height="4" Foreground="#1890FF" Background="#F0F0F0" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                    <!-- 实时日志 -->
                    <Border Grid.Row="3" Background="#1A1A1A" CornerRadius="6" Padding="12,8">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Logs}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock FontFamily="Consolas" FontSize="12" Foreground="#00E676">
                                            <Run Text="{Binding Time}"/>
                                            <Run Text="  "/>
                                            <Run Text="{Binding Text}"/>
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>
                <!-- 完成：成功（设计文档 §9.1） -->
                <Grid Visibility="{Binding IsFinishedOk, Converter={StaticResource BoolToVis}}" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel Width="440">
                        <TextBlock Text="✅" FontSize="56" HorizontalAlignment="Center"/>
                        <TextBlock Text="装机完成!" FontSize="24" Foreground="#1A1A1A" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                        <Border Background="#FAFAFA" CornerRadius="8" Padding="20" Margin="0,16,0,0">
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding SummaryItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="90"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Title}" FontSize="13" Foreground="#595959"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Content}" FontSize="13" Foreground="#1A1A1A" TextWrapping="Wrap"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding RebootText}" FontSize="13" Foreground="#8C8C8C" Margin="0,10,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                            <Button Content="返回首页" Style="{StaticResource SecondaryButton}" Command="{Binding BackHomeCommand}" Margin="0,0,12,0"/>
                            <Button Content="立即重启" Style="{StaticResource DangerButton}" Command="{Binding RestartNowCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
                <!-- 完成：失败（设计文档 §9.2） -->
                <Grid Visibility="{Binding IsFinishedOk, Converter={StaticResource InvBoolToVis}}" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="520">
                    <StackPanel Width="460">
                        <TextBlock Text="❌" FontSize="56" HorizontalAlignment="Center"/>
                        <TextBlock Text="装机失败" FontSize="24" Foreground="#1A1A1A" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                        <Border Background="#FFF1F0" BorderBrush="#FFA39E" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="{Binding FailStep, StringFormat=失败步骤: {0}}" FontSize="13" Foreground="#595959" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding FailReason, StringFormat=失败原因: {0}}" FontSize="13" Foreground="#FF4D4F" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#FAFAFA" CornerRadius="8" Padding="20" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="{Binding CompletedStepsText, StringFormat=已完成: {0}}" FontSize="13" Foreground="#389E0D" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding PendingStepsText, StringFormat=未完成: {0}}" FontSize="13" Foreground="#8C8C8C" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                <TextBlock Text="{Binding SuggestionText, StringFormat=建议: {0}}" FontSize="13" Foreground="#D46B08" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                        <Button Content="查看日志" Style="{StaticResource LinkButton}" HorizontalAlignment="Center" Margin="0,12,0,0" Command="{Binding ViewLogsCommand}"/>
                        <Border Background="#1A1A1A" CornerRadius="6" Padding="12,8" Margin="0,8,0,0" MaxHeight="120" Visibility="{Binding ShowFailLog, Converter={StaticResource BoolToVis}}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Logs}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock FontFamily="Consolas" FontSize="11" Foreground="#00E676">
                                                <Run Text="{Binding Time}"/>
                                                <Run Text="  "/>
                                                <Run Text="{Binding Text}"/>
                                            </TextBlock>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                            <Button Content="返回首页" Style="{StaticResource SecondaryButton}" Command="{Binding BackHomeCommand}" Margin="0,0,12,0"/>
                            <Button Content="重试" Style="{StaticResource DangerButton}" Command="{Binding RetryCommand}"/>
                        </StackPanel>
                    </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>        <!-- ===== 底部操作栏 ===== -->
        <Border Grid.Row="3" Background="White" BorderBrush="#E8E8E8" BorderThickness="0,1,0,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Button Content="上一步" Style="{StaticResource SecondaryButton}" Command="{Binding PrevCommand}"
                            Visibility="{Binding ShowPrevBottom, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,16,0">
                    <Button Content="{Binding NextText}" Style="{StaticResource PrimaryButton}" Command="{Binding NextCommand}"
                            Visibility="{Binding ShowNextBottom, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>