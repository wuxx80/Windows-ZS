<Window x:Class="WinPE_Client.UDiskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:WinPE_Client.Helpers"
        Title="ZS 装机助手 - U盘制作"
        Width="920" Height="650"
        WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#F5F6FA"
        FontFamily="Microsoft YaHei">
    <Window.Resources>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <helpers:BoolToInverseVisibilityConverter x:Key="InvBoolToVis"/>
        <helpers:StringToBrushConverter x:Key="StrToBrush"/>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="Background" Value="#1890FF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#40A9FF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#D9D9D9"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderBrush" Value="#D9D9D9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F5F5F5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="Background" Value="#FF4D4F"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF7875"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#F5F5F5"/>
                                <Setter Property="Foreground" Value="#D9D9D9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#1890FF"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F0F5FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardListBoxItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" Background="White" BorderBrush="#E8E8E8" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,6">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F0F5FF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E6F7FF"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#1890FF"/>
                                <Setter TargetName="bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PillItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" Width="170" Height="52" CornerRadius="8" BorderThickness="1" BorderBrush="#E8E8E8" Background="#FAFAFA" Padding="10,6">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontSize="13" Foreground="#333"/>
                                <TextBlock Text="{Binding Sub}" FontSize="10" Foreground="#8C8C8C" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E6F7FF"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#1890FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="54"/>
        </Grid.RowDefinitions>

        <!-- ===== 标题栏 ===== -->
        <Border x:Name="TitleBar" Grid.Row="0" Background="White" BorderBrush="#E8E8E8" BorderThickness="0,0,0,1" MouseLeftButtonDown="OnTitleBarMouseDown">
            <Grid>
                <TextBlock Text="ZS 装机助手 - U盘制作" FontSize="14" Foreground="#333" VerticalAlignment="Center" Margin="16,0,0,0"/>
                <Button Content="✕" Width="40" Height="40" HorizontalAlignment="Right" Background="Transparent" Foreground="#666" FontSize="14" Cursor="Hand" BorderThickness="0" ToolTip="关闭" Click="OnCloseClick">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#E8E8E8"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <!-- ===== 步骤导航 ===== -->
        <Border Grid.Row="1" Background="White" BorderBrush="#E8E8E8" BorderThickness="0,0,0,1">
            <ItemsControl ItemsSource="{Binding Steps}" VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="connector" Width="22" Height="2" Background="#E8E8E8" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <Border x:Name="dot" Width="24" Height="24" CornerRadius="12" BorderThickness="2" BorderBrush="#D9D9D9" VerticalAlignment="Center" Margin="0,0,6,0">
                                <TextBlock x:Name="txt" Text="{Binding Icon}" FontSize="11" Foreground="#BFBFBF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock x:Name="lbl" Text="{Binding Name}" FontSize="13" Foreground="#BFBFBF" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        </StackPanel>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                <Setter TargetName="dot" Property="BorderBrush" Value="#1890FF"/>
                                <Setter TargetName="txt" Property="Foreground" Value="#1890FF"/>
                                <Setter TargetName="txt" Property="FontSize" Value="14"/>
                                <Setter TargetName="lbl" Property="Foreground" Value="#1890FF"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                <Setter TargetName="connector" Property="Background" Value="#52C41A"/>
                                <Setter TargetName="dot" Property="BorderBrush" Value="#52C41A"/>
                                <Setter TargetName="txt" Property="Foreground" Value="#52C41A"/>
                                <Setter TargetName="lbl" Property="Foreground" Value="#52C41A"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Index}" Value="0">
                                <Setter TargetName="connector" Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- ===== 内容区域 ===== -->
        <Grid Grid.Row="2">
            <!-- 步骤① 输出方式 + 目标 -->
            <Grid Visibility="{Binding IsStep0, Converter={StaticResource BoolToVis}}" Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="选择输出方式" FontSize="18" Foreground="#333" VerticalAlignment="Center"/>
                </StackPanel>
                <ListBox Grid.Row="1" ItemsSource="{Binding OutputModes}" SelectedItem="{Binding SelectedOutputMode}"
                         ItemContainerStyle="{StaticResource PillItem}" Height="64" Margin="0,0,0,14">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>
                <!-- 写入 U 盘模式 -->
                <Grid Grid.Row="2" Visibility="{Binding IsUDiskMode, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="选择 U 盘" FontSize="13" Foreground="#333" VerticalAlignment="Center"/>
                        <Button Content="刷新" Style="{StaticResource SecondaryButton}" Margin="12,0,0,0" Command="{Binding RefreshDisksCommand}"/>
                    </StackPanel>
                    <ListBox Grid.Row="1" ItemsSource="{Binding UDisks}" SelectedItem="{Binding SelectedUDisk}"
                             ItemContainerStyle="{StaticResource CardListBoxItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             Visibility="{Binding HasNoUDisk, Converter={StaticResource InvBoolToVis}}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="磁盘 " FontSize="14" Foreground="#333"/>
                                        <TextBlock Text="{Binding Index}" FontSize="14" Foreground="#333"/>
                                        <TextBlock Text="{Binding Model}" FontSize="14" Foreground="#333" Margin="10,0,0,0"/>
                                        <TextBlock Text="{Binding CapacityText}" FontSize="12" Foreground="#666" Margin="10,1,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding DetailText}" FontSize="12" Foreground="#8C8C8C" Margin="0,4,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding HasNoUDisk, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="💾" FontSize="40" HorizontalAlignment="Center"/>
                        <TextBlock Text="未检测到 U 盘" FontSize="15" Foreground="#666" Margin="0,10,0,4" HorizontalAlignment="Center"/>
                        <TextBlock Text="请插入 U 盘后点击「刷新」" FontSize="12" Foreground="#999" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <Grid Grid.Row="2">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch">
                            <TextBlock Text="{Binding StatusText}" FontSize="13" Foreground="#8C8C8C" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- 生成 ISO 镜像模式 -->
                <Grid Grid.Row="2" Visibility="{Binding IsIsoMode, Converter={StaticResource BoolToVis}}">
                    <StackPanel VerticalAlignment="Top">
                        <TextBlock Text="选择 ISO 输出路径" FontSize="13" Foreground="#333" Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding IsoOutputPath}" IsReadOnly="True" Height="36" FontSize="13" Padding="8,0" Background="#FAFAFA" ToolTip="{Binding IsoOutputPath}"/>
                            <Button Grid.Column="1" Content="浏览" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Command="{Binding BrowseIsoOutputCommand}"/>
                        </Grid>
                        <TextBlock Text="{Binding IsoStatusText}" FontSize="12" Foreground="#8C8C8C" Margin="0,8,0,0"/>
                        <TextBlock Text="生成的 ISO 支持 UEFI + Legacy 双引导，可直接刻录或用于虚拟机" FontSize="12" Foreground="#8C8C8C" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>

                <TextBlock Grid.Row="3" Text="{Binding UDiskWarnText}" FontSize="13" Foreground="#FF4D4F" Margin="0,8,0,0"/>
            </Grid>

            <!-- 步骤② 选择 PE -->
            <Grid Visibility="{Binding IsStep1, Converter={StaticResource BoolToVis}}" Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="选择 PE 源" FontSize="18" Foreground="#333" VerticalAlignment="Center"/>
                </StackPanel>
                <ListBox Grid.Row="1" ItemsSource="{Binding PeSources}" SelectedItem="{Binding SelectedPeSource}"
                         Margin="0,0,0,12" Height="34">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="6" Padding="14,6" Background="#F0F0F0" BorderThickness="1" BorderBrush="#E8E8E8" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontSize="13"/>
                                    <TextBlock Text="{Binding Desc}" FontSize="10" Foreground="#8C8C8C" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- 服务器来源 -->
                <Grid Grid.Row="2" Visibility="{Binding IsServerSource, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="PE 版本列表" FontSize="13" Foreground="#333" VerticalAlignment="Center"/>
                        <Button Content="刷新" Style="{StaticResource LinkButton}" Command="{Binding RefreshPeCommand}"/>
                    </StackPanel>
                    <ListBox Grid.Row="1" ItemsSource="{Binding PeVersions}" SelectedItem="{Binding SelectedPeVersion}"
                             ItemContainerStyle="{StaticResource CardListBoxItem}"
                             Visibility="{Binding HasNoPeVersions, Converter={StaticResource InvBoolToVis}}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayText}" FontSize="13" Foreground="#333"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding HasNoPeVersions, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="暂无 PE 版本" FontSize="14" Foreground="#666" HorizontalAlignment="Center"/>
                        <TextBlock Text="请先在管理后台「PE版本」中添加并启用" FontSize="12" Foreground="#999" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- 本地来源 -->
                <Grid Grid.Row="2" Visibility="{Binding IsLocalSource, Converter={StaticResource BoolToVis}}" Margin="0,8,0,0">
                    <StackPanel VerticalAlignment="Top">
                        <TextBlock Text="选择本地 PE 文件" FontSize="13" Foreground="#333" Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding PeFilePath}" IsReadOnly="True" Height="36" FontSize="13" Padding="8,0" Background="#FAFAFA"/>
                            <Button Grid.Column="1" Content="浏览" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Command="{Binding BrowsePeCommand}"/>
                        </Grid>
                        <TextBlock Text="支持 .iso / .wim 格式" FontSize="12" Foreground="#8C8C8C" Margin="0,8,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- 在线 URL 来源 -->
                <Grid Grid.Row="2" Visibility="{Binding IsUrlSource, Converter={StaticResource BoolToVis}}" Margin="0,8,0,0">
                    <StackPanel VerticalAlignment="Top">
                        <TextBlock Text="输入 PE 镜像直链" FontSize="13" Foreground="#333" Margin="0,0,0,10"/>
                        <TextBox Text="{Binding PeUrl, UpdateSourceTrigger=PropertyChanged}" Height="36" FontSize="13" Padding="8,0"
                                 VerticalContentAlignment="Center" AcceptsReturn="False"/>
                        <TextBlock Text="例如 https://example.com/path/WPE10.iso，程序将直接下载该镜像用于制作" FontSize="12" Foreground="#8C8C8C" Margin="0,8,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- 步骤③ 制作选项 -->
            <ScrollViewer Visibility="{Binding IsStep2, Converter={StaticResource BoolToVis}}">
                <StackPanel Margin="24">
                    <TextBlock Text="制作选项" FontSize="18" Foreground="#333" Margin="0,0,0,14"/>
                    <TextBlock Text="文件系统" FontSize="13" Foreground="#333" Margin="0,0,0,8"/>
                    <ListBox ItemsSource="{Binding FileSystems}" SelectedItem="{Binding SelectedFileSystem}"
                             ItemContainerStyle="{StaticResource PillItem}" Height="64">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    </ListBox>
                    <TextBlock Text="引导类型" FontSize="13" Foreground="#333" Margin="0,10,0,8"/>
                    <ListBox ItemsSource="{Binding BootTypes}" SelectedItem="{Binding SelectedBootType}"
                             ItemContainerStyle="{StaticResource PillItem}" Height="64">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    </ListBox>
                    <TextBlock Text="分区方案" FontSize="13" Foreground="#333" Margin="0,10,0,8"/>
                    <ListBox ItemsSource="{Binding PartitionSchemes}" SelectedItem="{Binding SelectedPartition}"
                             ItemContainerStyle="{StaticResource PillItem}" Height="64" IsEnabled="{Binding IsEspDisabled, Converter={StaticResource InvBoolToVis}}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    </ListBox>
                    <TextBlock Text="卷标" FontSize="13" Foreground="#333" Margin="0,10,0,8"/>
                    <TextBox Text="{Binding VolumeLabel}" Width="200" Height="32" FontSize="13" Padding="8,0" HorizontalAlignment="Left"/>
                    <CheckBox Content="同时写入「装机助手客户端」（进 PE 自动续装）" IsChecked="{Binding IncludeClient}" FontSize="13" Margin="0,14,0,0"/>
                    <CheckBox Content="应用 PE 定制（壁纸/内置工具，需服务器配合）" IsChecked="{Binding ApplyCustomize}" FontSize="13" Margin="0,8,0,0"/>
                    <CheckBox Content="同时写入「内置工具大全」（进 PE 离线可用）" IsChecked="{Binding IncludeTools}" FontSize="13" Margin="0,8,0,0"/>
                    <Border Background="{Binding ConflictText, Converter={StaticResource StrToBrush}}" CornerRadius="6" Padding="12,8" Margin="0,14,0,0">
                        <TextBlock Text="{Binding ConflictText}" FontSize="13" Foreground="#D46B08"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 步骤④ 确认 + 执行 -->
            <Grid Visibility="{Binding IsStep3, Converter={StaticResource BoolToVis}}" Margin="24">
                <Grid Visibility="{Binding ShowExecution, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="确认与执行" FontSize="18" Foreground="#333" Margin="0,0,0,12"/>
                    <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="14">
                        <StackPanel>
                            <TextBlock Text="{Binding DestructiveWarnText}" FontSize="13" Foreground="#FF4D4F" Margin="0,0,0,10" TextWrapping="Wrap"/>
                            <ItemsControl ItemsSource="{Binding SummaryItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="24"/>
                                                <ColumnDefinition Width="70"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="13"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="13" Foreground="#666"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Content}" FontSize="13" Foreground="#333" TextWrapping="Wrap"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <ScrollViewer Grid.Row="2" Margin="0,12,0,0" Visibility="{Binding IsExecuting, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ProgressBar Grid.Column="0" Height="8" Minimum="0" Maximum="100" Value="{Binding ProgressValue}" Foreground="#1890FF" Background="#E8E8E8"/>
                                <TextBlock Grid.Column="1" Text="{Binding ProgressText}" FontSize="12" Foreground="#666" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding ExecSteps}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="8,4" CornerRadius="4" Background="#FAFAFA" Margin="0,0,0,4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="26"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding StatusIcon}" FontSize="13"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" Foreground="#333"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Detail}" FontSize="12" Foreground="#8C8C8C"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border Background="#FAFAFA" CornerRadius="6" Padding="10" Margin="0,8,0,0" MaxHeight="140">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding Logs}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Text}" FontSize="11" Foreground="#666" TextWrapping="Wrap"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                    <Grid Grid.Row="3" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Visibility="{Binding IsExecuting, Converter={StaticResource InvBoolToVis}}">
                            <TextBlock Text="{Binding ConfirmPrompt}" FontSize="13" Foreground="#333" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding ConfirmInput}" Width="120" Height="32" FontSize="14" Padding="8,0" HorizontalAlignment="Left"
                                     Visibility="{Binding IsUDiskMode, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="{Binding StartButtonText}" Style="{StaticResource DangerButton}" Command="{Binding StartCommand}" Margin="12,0,0,0"/>
                    </Grid>
                    <TextBlock Grid.Row="4" Text="{Binding StatusText}" FontSize="13" Foreground="#666" Margin="0,8,0,0"/>
                    <TextBlock Grid.Row="5" Text="{Binding FailReason}" FontSize="13" Foreground="#FF4D4F" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </Grid>

                <!-- 完成页：成功/失败/取消 分色展示 -->
                <Grid VerticalAlignment="Center" HorizontalAlignment="Center"
                      Visibility="{Binding ShowCompletion, Converter={StaticResource BoolToVis}}">
                    <!-- 成功 -->
                    <StackPanel Visibility="{Binding IsSuccess, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="✅" FontSize="48" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding StatusText}" FontSize="20" Foreground="#52C41A" HorizontalAlignment="Center" Margin="0,12,0,4"/>
                        <TextBlock Text="可以安全拔出 U 盘" FontSize="14" Foreground="#666" HorizontalAlignment="Center"/>
                        <Button Content="完成" Style="{StaticResource PrimaryButton}" Width="120" Margin="0,24,0,0" HorizontalAlignment="Center" Command="{Binding BackHomeCommand}"/>
                    </StackPanel>
                    <!-- 失败 -->
                    <StackPanel Visibility="{Binding IsFailed, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="❌" FontSize="48" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding StatusText}" FontSize="20" Foreground="#FF4D4F" HorizontalAlignment="Center" Margin="0,12,0,4"/>
                        <TextBlock Text="{Binding FailReason}" FontSize="13" Foreground="#FF4D4F" HorizontalAlignment="Center" Margin="0,8,0,0" TextWrapping="Wrap" MaxWidth="640"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,0">
                            <Button Content="重新制作" Style="{StaticResource SecondaryButton}" Width="110" Command="{Binding RetryCommand}"/>
                            <Button Content="完成" Style="{StaticResource PrimaryButton}" Width="110" Margin="12,0,0,0" Command="{Binding BackHomeCommand}"/>
                        </StackPanel>
                    </StackPanel>
                    <!-- 取消 -->
                    <StackPanel Visibility="{Binding IsCanceled, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="⏹" FontSize="48" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding StatusText}" FontSize="20" Foreground="#FA8C16" HorizontalAlignment="Center" Margin="0,12,0,4"/>
                        <TextBlock Text="未写入任何数据，可返回重新制作" FontSize="14" Foreground="#666" HorizontalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,0">
                            <Button Content="重新制作" Style="{StaticResource SecondaryButton}" Width="110" Command="{Binding RetryCommand}"/>
                            <Button Content="完成" Style="{StaticResource PrimaryButton}" Width="110" Margin="12,0,0,0" Command="{Binding BackHomeCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <!-- ===== 底部按钮 ===== -->
        <Border Grid.Row="3" Background="White" BorderBrush="#E8E8E8" BorderThickness="0,1,0,0" Padding="16,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="上一步" Style="{StaticResource SecondaryButton}" Command="{Binding PrevCommand}"
                        HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="{Binding ShowPrevBottom, Converter={StaticResource BoolToVis}}"/>
                <Button Grid.Column="1" Content="下一步" Style="{StaticResource PrimaryButton}" Margin="0,0,0,0"
                        VerticalAlignment="Center" Visibility="{Binding ShowNextBottom, Converter={StaticResource BoolToVis}}"
                        Command="{Binding NextCommand}" Width="110"/>
                <Button Grid.Column="2" Content="取消" Style="{StaticResource SecondaryButton}" Margin="12,0,0,0"
                        VerticalAlignment="Center" Visibility="{Binding ShowExecControls, Converter={StaticResource BoolToVis}}"
                        Command="{Binding CancelCommand}"/>
            </Grid>
        </Border>
    </Grid>
</Window>