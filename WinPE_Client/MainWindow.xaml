<Window x:Class="WinPE_Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WinPE_Client.ViewModels"
        Title="ZS 装机助手 - WinPE 客户端" 
        Height="600" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#F0F2F5"
        FontFamily="Microsoft YaHei">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>
    <Window.Resources>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Height" Value="45"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="15,0">
                            <TextBlock Text="{TemplateBinding Content}" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="Background" Value="#1976D2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <TextBlock Text="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#1E293B">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="60"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" BorderBrush="#334155" BorderThickness="0,0,0,1">
                    <StackPanel VerticalAlignment="Center" Margin="15,0">
                        <TextBlock Text="ZS 装机助手" FontSize="16" Foreground="White" FontWeight="SemiBold"/>
                        <TextBlock Text="WinPE 客户端" FontSize="11" Foreground="#94A3B8"/>
                    </StackPanel>
                </Border>
                <StackPanel Grid.Row="1" Margin="0,10,0,0">
                    <Button Content="首页" Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Home"/>
                    <Button Content="一键装机" Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Install"/>
                    <Button Content="磁盘工具" Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Disk"/>
                    <Button Content="引导修复" Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Boot"/>
                    <Button Content="驱动注入" Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Driver"/>
                    <Button Content="设置" Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Settings"/>
                </StackPanel>
                <Border Grid.Row="2" BorderBrush="#334155" BorderThickness="0,1,0,0" Padding="15">
                    <StackPanel>
                        <Border CornerRadius="4" Background="#334155" Padding="8">
                            <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap"/>
                        </Border>
                        <ProgressBar Value="{Binding ProgressValue}" Height="4" Margin="0,8,0,0" Foreground="#1976D2" Background="#475569"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="20">
                <StackPanel Visibility="{Binding CurrentView, Converter={StaticResource ViewConverter}, ConverterParameter=Home}">
                    <TextBlock Text="欢迎使用 ZS 装机助手" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBlock Text="WinPE 系统安装工具" FontSize="13" Foreground="#666" Margin="0,0,0,20"/>
                    <Border Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="服务器连接" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding ServerUrl}" Height="36" FontSize="13" IsEnabled="{Binding IsNotConnected}"/>
                                <Button Grid.Column="1" Content="连接" Style="{StaticResource ActionButton}" Margin="10,0,0,0" Width="80" Command="{Binding ConnectCommand}"/>
                            </Grid>
                            <Border CornerRadius="4" Padding="10">
                                                <TextBlock Text="{Binding StatusMessage}" FontSize="12"/>
                                            </Border>
                        </StackPanel>
                    </Border>
                    <Border Background="White" CornerRadius="8" Padding="20">
                        <TextBlock Text="从左侧菜单选择功能开始操作" FontSize="13" Foreground="#999"/>
                    </Border>
                </StackPanel>
                <StackPanel Visibility="{Binding CurrentView, Converter={StaticResource ViewConverter}, ConverterParameter=Install}">
                    <TextBlock Text="一键装机" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,15"/>
                    <Border Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,15">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="选择系统镜像" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <TextBox Text="{Binding SearchKeyword}" Width="150" Height="30" FontSize="12" Margin="0,0,5,0"/>
                                    <Button Content="搜索" Style="{StaticResource ActionButton}" Height="30" Command="{Binding RefreshImagesCommand}"/>
                                </StackPanel>
                            </Grid>
                            <ListBox ItemsSource="{Binding Images}" SelectedItem="{Binding SelectedImage}" Height="150" Margin="0,0,0,10" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="8" Margin="0,2">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Background="#E3F2FD" CornerRadius="4" Padding="6,3" Margin="0,0,10,0">
                                                    <TextBlock Text="{Binding Format}" FontSize="11" Foreground="#1565C0"/>
                                                </Border>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding SizeDisplay}" FontSize="11" Foreground="#888"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding OsType}" FontSize="11" Foreground="#666" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>
                    <Border Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,15">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="选择目标磁盘" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="刷新" Style="{StaticResource ActionButton}" Height="30" Command="{Binding RefreshDisksCommand}"/>
                            </Grid>
                            <ListBox ItemsSource="{Binding Disks}" SelectedItem="{Binding SelectedDisk}" Height="120" Margin="0,0,0,10" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="8" Margin="0,2">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Background="#FFF3E0" CornerRadius="4" Padding="6,3" Margin="0,0,10,0">
                                                    <TextBlock Text="{Binding Index, StringFormat=磁盘 {0}}" FontSize="11" Foreground="#E65100"/>
                                                </Border>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Model}" FontSize="13" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding SizeDisplay}" FontSize="11" Foreground="#888"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding InterfaceType}" FontSize="11" Foreground="#666" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>
                    <Border Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="安装选项" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                            <CheckBox IsChecked="{Binding AutoPartition}" Content="自动分区 (GPT)" Margin="0,0,0,8"/>
                            <CheckBox IsChecked="{Binding AutoRepairBoot}" Content="自动修复引导" Margin="0,0,0,8"/>
                            <CheckBox IsChecked="{Binding AutoInjectDrivers}" Content="自动注入驱动" Margin="0,0,0,8"/>
                            <TextBox Text="{Binding DriverPath}" Height="30" FontSize="12" IsEnabled="{Binding AutoInjectDrivers}" ToolTip="驱动文件夹路径"/>
                        </StackPanel>
                    </Border>
                    <Button Content="开始装机" Style="{StaticResource ActionButton}" Height="44" FontSize="16" Command="{Binding StartInstallCommand}" HorizontalAlignment="Center" Width="200"/>
                </StackPanel>
                <StackPanel Visibility="{Binding CurrentView, Converter={StaticResource ViewConverter}, ConverterParameter=Disk}">
                    <TextBlock Text="磁盘工具" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,15"/>
                    <Border Background="White" CornerRadius="8" Padding="20">
                        <StackPanel>
                            <TextBlock Text="磁盘分区管理功能" FontSize="13" Foreground="#666"/>
                            <Button Content="刷新磁盘列表" Style="{StaticResource ActionButton}" Margin="0,15,0,0" Command="{Binding RefreshDisksCommand}"/>
                            <ListBox ItemsSource="{Binding Disks}" Height="200" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel Visibility="{Binding CurrentView, Converter={StaticResource ViewConverter}, ConverterParameter=Boot}">
                    <TextBlock Text="引导修复" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,15"/>
                    <Border Background="White" CornerRadius="8" Padding="20">
                        <StackPanel>
                            <TextBlock Text="修复 Windows 引导（支持 UEFI + BIOS）" FontSize="13" Foreground="#666" Margin="0,0,0,15"/>
                            <Button Content="开始修复引导" Style="{StaticResource ActionButton}" Command="{Binding BootRepairCommand}" Width="160"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel Visibility="{Binding CurrentView, Converter={StaticResource ViewConverter}, ConverterParameter=Driver}">
                    <TextBlock Text="驱动注入" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,15"/>
                    <Border Background="White" CornerRadius="8" Padding="20">
                        <StackPanel>
                            <TextBlock Text="向已安装的系统注入驱动" FontSize="13" Foreground="#666" Margin="0,0,0,15"/>
                            <TextBox Text="{Binding DriverPath}" Height="36" FontSize="13" ToolTip="驱动文件夹路径"/>
                            <Button Content="开始注入驱动" Style="{StaticResource ActionButton}" Margin="0,15,0,0" Command="{Binding InjectDriversCommand}" Width="160"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel Visibility="{Binding CurrentView, Converter={StaticResource ViewConverter}, ConverterParameter=Settings}">
                    <TextBlock Text="设置" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,15"/>
                    <Border Background="White" CornerRadius="8" Padding="20">
                        <StackPanel>
                            <TextBlock Text="服务器地址" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding ServerUrl}" Height="36" FontSize="13" Margin="0,0,0,15"/>
                            <TextBlock Text="版本信息" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <TextBlock Text="ZS 装机助手 WinPE 客户端 v1.0.0" FontSize="12" Foreground="#888"/>
                            <TextBlock Text="目标框架: .NET 8.0" FontSize="12" Foreground="#888"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>